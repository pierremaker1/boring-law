{
  "name": "video-70-ans-ia",
  "version": "1.0.0",
  "private": true,
  "description": "70 ans d'IA en 40 secondes : vidéo verticale Remotion",
  "scripts": {
    "embed": "node scripts/embed-source.mjs",
    "predev": "npm run embed",
    "dev": "remotion studio",
    "pretypecheck": "npm run embed",
    "typecheck": "tsc --noEmit",
    "prestills": "npm run embed",
    "stills": "node scripts/stills.mjs out/previews",
    "prerender": "npm run embed",
    "render": "remotion render SeventyYearsAI out/70-ans-ia.mp4 --codec=h264 --crf=18"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/google-fonts": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
